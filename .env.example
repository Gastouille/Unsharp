# =============================================================================
#  Unsharp Candles bot - secrets and environment overrides
#  Copy this file to .env and fill it in.  NEVER commit .env to git.
# =============================================================================

# --- XTB credentials (xStation5 / xAPI) --------------------------------------
# There is no separate API key: you use your xStation account number and
# password. Create a dedicated demo account first.
XTB_USER_ID=12345678
XTB_PASSWORD=your_xstation_password

# demo -> wss://ws.xtb.com/demo    + wss://ws.xtb.com/demoStream
# real -> wss://ws.xtb.com/real    + wss://ws.xtb.com/realStream
XTB_MODE=demo

# Name reported to XTB (cosmetic, shown in the account activity log).
XTB_APP_NAME=unsharp-bot

# --- Optional overrides of config.yaml ---------------------------------------
# Anything set here wins over the YAML file, which is handy for a quick test
# without editing the configuration.

# UNSHARP_BROKER=paper              # force the offline simulated broker
# UNSHARP_DRY_RUN=true              # detect and journal, never send orders
# UNSHARP_RISK_FRACTION=0.5         # fraction of available capital per trade
# UNSHARP_MAX_LOSS_FRACTION=0.02    # hard max loss per trade (fraction of equity)
# UNSHARP_BUFFER_FRACTION=0.10      # safety buffer away from the margin call
# UNSHARP_SYMBOLS=EURUSD,US500      # comma-separated symbol list
# UNSHARP_LOG_LEVEL=DEBUG
